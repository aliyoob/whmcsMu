# Example answers file for setup-whmcs.sh and deploy.sh.
#
#   cp infrastructure/answers.env.example infrastructure/answers.env
#   ./infrastructure/setup-whmcs.sh --config infrastructure/answers.env
#
# answers.env is gitignored. Do not put the SSH or database password here on a
# shared machine — leave them out and the script will prompt.

VPS_HOST='198.51.100.10'
VPS_SSH_PORT='22'
VPS_SSH_USER='root'
VPS_AUTH_METHOD='key'          # key | password
VPS_SSH_KEY='~/.ssh/id_ed25519'

WHMCS_DOMAIN='billing.example.com'
WHMCS_ADMIN_EMAIL='ops@example.com'
WHMCS_WEBROOT='/var/www/whmcs'
WHMCS_PHP='8.2'                # 8.1, 8.2 or 8.3

WHMCS_DB_NAME='whmcs'
WHMCS_DB_USER='whmcs'
# WHMCS_DB_PASSWORD=''         # generated when omitted

WHMCS_ISSUE_TLS='y'
WHMCS_CONFIGURE_FIREWALL='y'

# Path to the archive from your WHMCS members area, a URL, or 'skip'.
WHMCS_ARCHIVE='skip'

WTP_STORAGE_PATH='/var/lib/whmcs-wtp/packages'
WTP_ENV_PATH='/etc/whmcs-wtp/wtp.env'
WTP_DEPLOY_CODE='y'
